# Copy this file to .env and fill in what you need. Every line is optional.

# --- LLM ---------------------------------------------------------------
# Leave empty to use the free offline mock. Set it to use Claude for answers
# and for the LLM-as-judge groundedness check.
ANTHROPIC_API_KEY=

# auto (default) = claude if a key is set, otherwise mock. Or force: claude | mock
LLM_PROVIDER=auto
CHAT_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (how much the model thinks before answering)
CHAT_EFFORT=low
JUDGE_EFFORT=medium

# --- Retrieval ---------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=4
MIN_RETRIEVAL_SCORE=0.55

# --- Safety ------------------------------------------------------------
GUARDRAILS_ENABLED=true

# --- Uploaded manuals (chat page) ---------------------------------------
# Largest manual the chat page accepts, in MB
MAX_UPLOAD_MB=20
# Where uploaded manuals are kept (default: data/uploads)
# UPLOADS_DIR=
# Scanned pages and photos are read with OCR, about 6 seconds a page. Most pages per manual:
OCR_MAX_PAGES=60
# The English OCR model is downloaded here on first use (default: .cache/ocr)
# OCR_MODEL_DIR=

# Silences a harmless Windows warning from the model downloader
HF_HUB_DISABLE_SYMLINKS_WARNING=1
